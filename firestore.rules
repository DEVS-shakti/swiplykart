rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Lock writes to Firebase Console / Admins only
    }
    
    // Private User Data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Anonymous/Public Affiliate Click Tracking
    match /clicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if false; // Protect analytics from being scraped locally
    }
  }
}
